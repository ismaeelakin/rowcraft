{
  "name": "rowcraft",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A private, browser-based CSV checking and cleanup workbench",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "preview": "python -m http.server 8090 --directory site --bind 127.0.0.1",
    "benchmark": "npm run build && node scripts/benchmark.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "^22.15.30",
    "prettier": "3.6.2"
  }
}
